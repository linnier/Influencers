{
  "name": "达人管理系统在线预览",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "达人管理系统",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "containerEnv": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "INFLUENCERS_DB_PATH": "${containerWorkspaceFolder}/.preview/influencers.sqlite"
  },
  "postCreateCommand": "npm ci --no-audit --no-fund",
  "postStartCommand": "bash .devcontainer/start-preview.sh"
}
